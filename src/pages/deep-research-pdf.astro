---
import '../styles/global.css';
import {
  AgingTrendChart, SingleHouseholdChart,
  CaregivingInsuranceChart, DementiaProjectionChart,
  AIMatchingShareChart,
  PetMarketChart, PetInsuranceComparisonChart,
  ElderlyAccidentTrendChart, LicenseSurrenderChart, ElderlyDriverProjectionChart,
} from '../components/react/DeepResearchCharts';
import {
  item1Stats, item1Sources,
  item2Stats, item2Sources,
  item6Stats, item6Sources,
  item8Stats, item8Sources,
  comparisonMatrix,
} from '../data/deepResearchData';
---

<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Deep Research PDF - AI 사업 아이템 심층 분석</title>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;500;700;900&family=Outfit:wght@300;400;600;700;800;900&display=swap" rel="stylesheet">
  <style is:global>
    /* ─── PDF 전용 인쇄 스타일 ─────────────────────────── */
    @page {
      size: A4 landscape;
      margin: 14mm 16mm;
    }

    * { -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; color-adjust: exact !important; }

    body.pdf-mode {
      background: #0a0e1a;
      color: #e2e8f0;
      font-family: 'Noto Sans KR', sans-serif;
      line-height: 1.6;
      margin: 0;
      padding: 0;
    }

    /* 인쇄 시 숨길 요소 */
    .no-print { display: flex; }
    @media print {
      .no-print { display: none !important; }
    }

    /* ─── 페이지 브레이크 ──────────────────────────────── */
    .pdf-page {
      page-break-before: always;
      padding: 20px 0;
    }
    .pdf-page:first-of-type {
      page-break-before: avoid;
    }
    .pdf-avoid-break {
      page-break-inside: avoid;
    }

    /* ─── 표지 ─────────────────────────────────────────── */
    .pdf-cover {
      min-height: calc(100vh - 28mm);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      position: relative;
      overflow: hidden;
      padding: 40px 20px;
    }
    @media print {
      .pdf-cover { min-height: auto; height: 100vh; box-sizing: border-box; }
    }
    .pdf-cover::before {
      content: '';
      position: absolute;
      top: -50%; left: -50%;
      width: 200%; height: 200%;
      background: radial-gradient(ellipse at 30% 50%, rgba(59,130,246,0.18) 0%, transparent 50%),
                  radial-gradient(ellipse at 70% 50%, rgba(139,92,246,0.14) 0%, transparent 50%);
      pointer-events: none;
    }
    .pdf-cover-content { position: relative; z-index: 1; }
    .pdf-cover-badge {
      display: inline-block;
      background: rgba(59,130,246,0.15);
      border: 1px solid rgba(59,130,246,0.3);
      padding: 8px 24px;
      border-radius: 100px;
      font-size: 0.85rem;
      color: #3b82f6;
      margin-bottom: 32px;
      letter-spacing: 1px;
    }
    .pdf-cover h1 {
      font-family: 'Outfit', sans-serif;
      font-size: 3.2rem;
      font-weight: 900;
      line-height: 1.2;
      margin-bottom: 20px;
      background: linear-gradient(135deg, #fff 20%, #3b82f6 50%, #8b5cf6 80%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .pdf-cover-sub {
      font-size: 1.1rem;
      color: #94a3b8;
      max-width: 700px;
      margin: 0 auto 48px;
    }
    .pdf-cover-stats {
      display: flex;
      justify-content: center;
      gap: 56px;
      margin-bottom: 48px;
    }
    .pdf-cover-stat-num {
      font-family: 'Outfit', sans-serif;
      font-size: 2.4rem;
      font-weight: 800;
      background: linear-gradient(135deg, #3b82f6, #8b5cf6);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .pdf-cover-stat-label { font-size: 0.85rem; color: #94a3b8; margin-top: 4px; }
    .pdf-cover-meta {
      margin-top: 32px;
      font-size: 0.9rem;
      color: #64748b;
    }
    .pdf-cover-meta strong { color: #94a3b8; }

    /* ─── 섹션 공통 ────────────────────────────────────── */
    .pdf-section {
      max-width: 1100px;
      margin: 0 auto;
      padding: 0 16px;
    }
    .pdf-section-header {
      text-align: center;
      margin-bottom: 32px;
      padding-top: 8px;
    }
    .pdf-section-num {
      font-family: 'Outfit', sans-serif;
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 3px;
      color: #3b82f6;
      margin-bottom: 8px;
    }
    .pdf-section-title {
      font-family: 'Outfit', sans-serif;
      font-size: 1.8rem;
      font-weight: 800;
      color: #f8fafc;
      margin-bottom: 10px;
    }
    .pdf-section-desc {
      color: #94a3b8;
      max-width: 600px;
      margin: 0 auto;
      font-size: 0.88rem;
    }

    /* ─── 스탯 행 ──────────────────────────────────────── */
    .pdf-stat-row {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 12px;
      margin: 20px 0;
    }
    .pdf-stat-box {
      background: #1a2236;
      border-radius: 14px;
      padding: 18px 14px;
      text-align: center;
      border: 1px solid rgba(255,255,255,0.04);
    }
    .pdf-stat-num {
      font-family: 'Outfit', sans-serif;
      font-size: 1.5rem;
      font-weight: 800;
      margin-bottom: 3px;
    }
    .pdf-stat-label { font-size: 0.72rem; color: #94a3b8; }

    /* ─── 인사이트 박스 ────────────────────────────────── */
    .pdf-insight {
      background: linear-gradient(135deg, rgba(59,130,246,0.08), rgba(139,92,246,0.08));
      border: 1px solid rgba(59,130,246,0.2);
      border-radius: 14px;
      padding: 20px 24px;
      margin: 16px 0;
    }
    .pdf-insight h4 {
      font-size: 0.88rem;
      color: #3b82f6;
      margin-bottom: 8px;
    }
    .pdf-insight p {
      font-size: 0.82rem;
      color: #e2e8f0;
      line-height: 1.65;
    }

    /* ─── SWOT 그리드 ──────────────────────────────────── */
    .pdf-swot {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      margin: 16px 0;
    }
    .pdf-swot-cell {
      padding: 16px;
      border-radius: 12px;
      border: 1px solid rgba(255,255,255,0.06);
    }
    .pdf-swot-cell h5 {
      font-size: 0.82rem;
      font-weight: 700;
      margin-bottom: 8px;
    }
    .pdf-swot-cell ul { list-style: none; padding: 0; margin: 0; }
    .pdf-swot-cell li {
      font-size: 0.75rem;
      color: #94a3b8;
      padding: 2px 0 2px 12px;
      position: relative;
    }
    .pdf-swot-cell li::before {
      content: '\2022';
      position: absolute;
      left: 0;
      color: #3b82f6;
    }

    /* ─── 참조자료 ─────────────────────────────────────── */
    .pdf-sources {
      margin-top: 16px;
      padding: 16px 20px;
      background: #1a2236;
      border-radius: 12px;
      border: 1px solid rgba(255,255,255,0.04);
    }
    .pdf-sources h4 {
      font-size: 0.8rem;
      font-weight: 700;
      color: #f8fafc;
      margin-bottom: 8px;
    }
    .pdf-sources ul { list-style: none; padding: 0; margin: 0; }
    .pdf-sources li {
      font-size: 0.72rem;
      padding: 3px 0;
      color: #94a3b8;
      border-bottom: 1px solid rgba(255,255,255,0.03);
    }
    .pdf-sources li:last-child { border-bottom: none; }
    .pdf-sources a { color: #3b82f6; text-decoration: none; }

    /* ─── 메가트렌드 카드 ──────────────────────────────── */
    .pdf-trend-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 14px;
      margin-bottom: 24px;
    }
    .pdf-trend-card {
      border-radius: 14px;
      padding: 20px;
    }
    .pdf-trend-card--aging {
      background: linear-gradient(135deg, rgba(239,68,68,0.08), rgba(245,158,11,0.08));
      border: 1px solid rgba(245,158,11,0.15);
    }
    .pdf-trend-card--ai {
      background: linear-gradient(135deg, rgba(59,130,246,0.08), rgba(139,92,246,0.08));
      border: 1px solid rgba(59,130,246,0.15);
    }
    .pdf-trend-card--personal {
      background: linear-gradient(135deg, rgba(16,185,129,0.08), rgba(6,182,212,0.08));
      border: 1px solid rgba(16,185,129,0.15);
    }
    .pdf-trend-card h4 {
      font-size: 0.95rem;
      color: #f8fafc;
      margin-bottom: 6px;
    }
    .pdf-trend-card p {
      font-size: 0.78rem;
      color: #94a3b8;
      line-height: 1.6;
    }

    /* ─── 비교 테이블 ──────────────────────────────────── */
    .pdf-comp-table {
      width: 100%;
      border-collapse: separate;
      border-spacing: 0 6px;
      margin: 20px 0;
    }
    .pdf-comp-table th {
      text-align: left;
      padding: 10px 12px;
      font-size: 0.72rem;
      font-weight: 600;
      color: #94a3b8;
      text-transform: uppercase;
      letter-spacing: 1px;
    }
    .pdf-comp-table td {
      padding: 12px;
      background: #1a2236;
      font-size: 0.78rem;
      color: #e2e8f0;
    }
    .pdf-comp-table tr td:first-child { border-radius: 10px 0 0 10px; }
    .pdf-comp-table tr td:last-child { border-radius: 0 10px 10px 0; }

    /* ─── 결론 ─────────────────────────────────────────── */
    .pdf-conclusion {
      background: linear-gradient(135deg, rgba(59,130,246,0.1), rgba(139,92,246,0.1));
      border-radius: 20px;
      padding: 48px 40px;
      text-align: center;
      border: 1px solid rgba(59,130,246,0.15);
      margin-top: 32px;
    }
    .pdf-conclusion h2 {
      font-family: 'Outfit', sans-serif;
      font-size: 1.8rem;
      font-weight: 800;
      margin-bottom: 16px;
      color: #f8fafc;
    }
    .pdf-conclusion p {
      color: #94a3b8;
      max-width: 650px;
      margin: 0 auto;
      font-size: 0.88rem;
      line-height: 1.7;
    }

    /* ─── 플로우 ───────────────────────────────────────── */
    .pdf-flow {
      display: flex;
      align-items: center;
      gap: 6px;
      justify-content: center;
      margin: 16px 0;
    }
    .pdf-flow-step {
      background: #1a2236;
      border: 1px solid rgba(255,255,255,0.06);
      border-radius: 12px;
      padding: 12px 16px;
      text-align: center;
      min-width: 110px;
    }
    .pdf-flow-step-icon { font-size: 1.3rem; margin-bottom: 4px; }
    .pdf-flow-step-text { font-size: 0.72rem; font-weight: 600; color: #e2e8f0; }
    .pdf-flow-arrow { font-size: 1rem; color: #3b82f6; }

    /* ─── 인쇄 버튼 ───────────────────────────────────── */
    .pdf-print-bar {
      position: fixed;
      top: 0; left: 0; right: 0;
      z-index: 100;
      background: rgba(10,14,26,0.95);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid rgba(255,255,255,0.06);
      padding: 12px 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .pdf-print-bar span {
      color: #94a3b8;
      font-size: 0.85rem;
    }
    .pdf-print-bar a {
      color: #94a3b8;
      text-decoration: none;
      font-size: 0.85rem;
    }
    .pdf-print-bar a:hover { color: #3b82f6; }
    .pdf-print-btn {
      background: linear-gradient(135deg, #3b82f6, #8b5cf6);
      color: #fff;
      border: none;
      padding: 10px 28px;
      border-radius: 100px;
      font-size: 0.9rem;
      font-weight: 600;
      cursor: pointer;
      font-family: 'Noto Sans KR', sans-serif;
    }
    .pdf-print-btn:hover { opacity: 0.9; }

    /* ─── 차트 래퍼 오버라이드 (PDF용 축소) ────────────── */
    @media print {
      body.pdf-mode { padding-top: 0 !important; }
    }
    body.pdf-mode { padding-top: 56px; }
  </style>
</head>
<body class="pdf-mode">

<!-- 인쇄 버튼 바 -->
<div class="pdf-print-bar no-print">
  <div style="display: flex; align-items: center; gap: 16px;">
    <a href="/deep-research">← Deep Research로 돌아가기</a>
    <span>|</span>
    <span>PDF 출력 최적화 페이지 — Ctrl+P (Cmd+P) → 가로 방향 → 배경 그래픽 체크</span>
  </div>
  <button class="pdf-print-btn" onclick="window.print()">PDF로 저장</button>
</div>

<!-- ═══════════════════════════════════════════════════ -->
<!-- PAGE 1: 표지 -->
<!-- ═══════════════════════════════════════════════════ -->
<div class="pdf-cover">
  <div class="pdf-cover-content">
    <div class="pdf-cover-badge">TEAM-J Deep Research</div>
    <h1>AI 사업 아이템<br>심층 리서치 보고서</h1>
    <p class="pdf-cover-sub">4개 핵심 사업 아이템에 대한 시장 데이터, 기술 동향, 정책 환경을 근거 자료와 함께 심층 분석</p>
    <div class="pdf-cover-stats">
      <div>
        <div class="pdf-cover-stat-num">4</div>
        <div class="pdf-cover-stat-label">핵심 아이템</div>
      </div>
      <div>
        <div class="pdf-cover-stat-num">20+</div>
        <div class="pdf-cover-stat-label">참조 자료</div>
      </div>
      <div>
        <div class="pdf-cover-stat-num">10</div>
        <div class="pdf-cover-stat-label">데이터 차트</div>
      </div>
    </div>
    <div class="pdf-cover-meta">
      <strong>2026.03</strong> &nbsp;|&nbsp; TEAM-J : 이정로, 정영, 이진영
    </div>
  </div>
</div>

<!-- ═══════════════════════════════════════════════════ -->
<!-- PAGE 2: 거시 환경 - 전제 + 고령화 -->
<!-- ═══════════════════════════════════════════════════ -->
<div class="pdf-page">
  <div class="pdf-section">
    <div class="pdf-section-header">
      <div class="pdf-section-num">MACRO TRENDS</div>
      <div class="pdf-section-title">거시 환경 분석</div>
      <p class="pdf-section-desc">초고령사회 진입, 1인가구 급증, AI 대중화 — 4개 아이템 모두를 관통하는 메가트렌드</p>
    </div>

    <div class="pdf-trend-grid">
      <div class="pdf-trend-card pdf-trend-card--aging">
        <h4>👥 소비자 니즈 분석</h4>
        <p>고령화·1인가구 등 소비자의 미충족 니즈에서 출발한 아이템이 <strong style="color: #f59e0b;">전체의 64%</strong>. 페인포인트가 핵심 동인.</p>
      </div>
      <div class="pdf-trend-card pdf-trend-card--ai">
        <h4>🤖 기술변화 분석</h4>
        <p>AI/NLP, IoT, 컴퓨터비전 등 <strong style="color: #3b82f6;">기술 변곡점</strong>에서 비롯된 아이템이 <strong style="color: #3b82f6;">100%</strong>. AI 기반 혁신이 핵심.</p>
      </div>
      <div class="pdf-trend-card pdf-trend-card--personal">
        <h4>📈 메가트렌드 분석</h4>
        <p>초고령사회, AI 대중화, 개인화 소비 등 <strong style="color: #10b981;">거시적 메가트렌드</strong> 연계 아이템 <strong style="color: #10b981;">82%</strong>.</p>
      </div>
    </div>

    <AgingTrendChart client:load />
  </div>
</div>

<!-- ═══════════════════════════════════════════════════ -->
<!-- PAGE 3: 거시 환경 - 1인가구 + AI 시장 -->
<!-- ═══════════════════════════════════════════════════ -->
<div class="pdf-page">
  <div class="pdf-section">
    <SingleHouseholdChart client:load />

    <div class="pdf-stat-row" style="margin-top: 24px;">
      <div class="pdf-stat-box">
        <div class="pdf-stat-num" style="color: #3b82f6;">6.3조원</div>
        <div class="pdf-stat-label">한국 AI 시장 매출(2024)</div>
      </div>
      <div class="pdf-stat-box">
        <div class="pdf-stat-num" style="color: #8b5cf6;">CAGR 32.7%</div>
        <div class="pdf-stat-label">AI 기업 수 증가율</div>
      </div>
      <div class="pdf-stat-box">
        <div class="pdf-stat-num" style="color: #06b6d4;">60%</div>
        <div class="pdf-stat-label">AI 에이전트 도입 예정(2025)</div>
      </div>
      <div class="pdf-stat-box">
        <div class="pdf-stat-num" style="color: #f59e0b;">$78.7B</div>
        <div class="pdf-stat-label">글로벌 AI-in-IoT 시장</div>
      </div>
    </div>
  </div>
</div>

<!-- ═══════════════════════════════════════════════════ -->
<!-- PAGE 4: 아이템1 - 통계 + 차트 -->
<!-- ═══════════════════════════════════════════════════ -->
<div class="pdf-page">
  <div class="pdf-section">
    <div class="pdf-section-header">
      <div class="pdf-section-num">ITEM 01</div>
      <div class="pdf-section-title">AI 인지저하 탐지 + 간병보험 연계</div>
      <p class="pdf-section-desc">스마트폰 사용 패턴·음성 분석으로 초기 인지 저하를 탐지, 간병보험 리스크 관리와 예방 서비스 연계</p>
    </div>

    <div class="pdf-stat-row">
      <div class="pdf-stat-box">
        <div class="pdf-stat-num" style="color: #3b82f6;">{item1Stats.marketSize}</div>
        <div class="pdf-stat-label">{item1Stats.marketSizeLabel}</div>
      </div>
      <div class="pdf-stat-box">
        <div class="pdf-stat-num" style="color: #ef4444;">{item1Stats.growth}</div>
        <div class="pdf-stat-label">{item1Stats.growthLabel}</div>
      </div>
      <div class="pdf-stat-box">
        <div class="pdf-stat-num" style="color: #f59e0b;">{item1Stats.targetUsers}</div>
        <div class="pdf-stat-label">{item1Stats.targetUsersLabel}</div>
      </div>
      <div class="pdf-stat-box">
        <div class="pdf-stat-num" style="color: #06b6d4;">{item1Stats.nationalCost}</div>
        <div class="pdf-stat-label">{item1Stats.nationalCostLabel}</div>
      </div>
    </div>

    <CaregivingInsuranceChart client:load />
  </div>
</div>

<!-- ═══════════════════════════════════════════════════ -->
<!-- PAGE 5: 아이템1 - 치매 전망 + 기술 동향 -->
<!-- ═══════════════════════════════════════════════════ -->
<div class="pdf-page">
  <div class="pdf-section">
    <DementiaProjectionChart client:load />

    <div class="pdf-insight">
      <h4>핵심 기술 동향</h4>
      <p><strong>Samsung Research</strong>: 스마트폰/웨어러블 데이터(타이핑 속도, 백스페이스 빈도, 보행 속도 등) 기반 디지털 바이오마커 기술 개발. 병원 기반 치매 선별검사와 <strong>동등한 정확도</strong>. 2026년 중반 미국·한국 공개 베타 예정.</p>
    </div>
    <div class="pdf-insight">
      <h4>경쟁사 분석</h4>
      <p><strong>Linus Health</strong>(미국): Gartner Hype Cycle 2025 등재, Aural Analytics(FDA 혁신기기) 인수. <strong>LANGaware</strong>(유럽): 음성 바이오마커로 MCI/알츠하이머 감지. AI 음성 MCI 탐지 <strong>AUC 0.945~0.988</strong>.</p>
    </div>
  </div>
</div>

<!-- ═══════════════════════════════════════════════════ -->
<!-- PAGE 6: 아이템1 - SWOT + 참조자료 -->
<!-- ═══════════════════════════════════════════════════ -->
<div class="pdf-page">
  <div class="pdf-section">
    <div class="pdf-section-header" style="margin-bottom: 20px;">
      <div class="pdf-section-num">ITEM 01</div>
      <div class="pdf-section-title" style="font-size: 1.4rem;">SWOT 분석 — AI 인지저하 탐지 + 간병보험</div>
    </div>

