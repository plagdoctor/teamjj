---
import '../styles/global.css';
import {
  AgingTrendChart, SingleHouseholdChart,
  CaregivingInsuranceChart, DementiaProjectionChart,
  AIMatchingShareChart,
  PetMarketChart, PetInsuranceComparisonChart,
  ElderlyAccidentTrendChart, LicenseSurrenderChart, ElderlyDriverProjectionChart,
} from '../components/react/DeepResearchCharts';
import {
  item1Stats, item1Sources,
  item2Stats, item2Sources,
  item6Stats, item6Sources,
  item8Stats, item8Sources,
  comparisonMatrix,
} from '../data/deepResearchData';
---

<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Deep Research PDF - AI 사업 아이템 심층 분석</title>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;500;700;900&family=Outfit:wght@300;400;600;700;800;900&display=swap" rel="stylesheet">
  <style is:global>
    @page {
      size: A4 landscape;
      margin: 10mm 14mm;
    }
    * {
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
      color-adjust: exact !important;
    }

    body.pdf-mode {
      background: #0a0e1a;
      color: #e2e8f0;
      font-family: 'Noto Sans KR', sans-serif;
      line-height: 1.5;
      margin: 0;
      padding: 0;
    }
    body.pdf-mode { padding-top: 52px; }
    @media print { body.pdf-mode { padding-top: 0 !important; } }

    /* ━━ ChartWrapper 인라인 스타일 강제 오버라이드 ━━━━━━━━ */
    body.pdf-mode .pdf-section > div > div {
      margin-bottom: 12px !important;
      opacity: 1 !important;
      transform: none !important;
    }
    /* ChartWrapper 내부 카드 패딩 축소 */
    body.pdf-mode .pdf-section > div > div > div:last-child {
      padding: 14px 18px !important;
      border-radius: 12px !important;
    }
    /* ChartWrapper 제목 축소 */
    body.pdf-mode .pdf-section > div > div > h3 {
      font-size: 1rem !important;
      margin-bottom: 4px !important;
    }
    /* ChartWrapper 설명 축소 */
    body.pdf-mode .pdf-section > div > div > p {
      font-size: 0.75rem !important;
      margin-bottom: 10px !important;
    }
    /* 차트 높이 강제 축소 */
    body.pdf-mode .pdf-section .recharts-responsive-container {
      max-height: 240px !important;
    }
    body.pdf-mode .pdf-section > div > div > div:last-child > div {
      height: 240px !important;
    }

    /* ━━ 인쇄 숨김 ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */
    .no-print { display: flex; }
    @media print { .no-print { display: none !important; } }

    /* ━━ 페이지 구분 ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */
    .pdf-page {
      page-break-before: always;
      page-break-inside: avoid;
      padding: 4px 0;
    }
    .pdf-page:first-of-type { page-break-before: avoid; }

    /* ━━ 표지 ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */
    .pdf-cover {
      min-height: calc(100vh - 20mm);
      display: flex; flex-direction: column;
      align-items: center; justify-content: center;
      text-align: center; position: relative; overflow: hidden;
      padding: 40px 20px;
    }
    @media print { .pdf-cover { min-height: auto; height: 100vh; } }
    .pdf-cover::before {
      content: ''; position: absolute;
      top: -50%; left: -50%; width: 200%; height: 200%;
      background: radial-gradient(ellipse at 30% 50%, rgba(59,130,246,0.18) 0%, transparent 50%),
                  radial-gradient(ellipse at 70% 50%, rgba(139,92,246,0.14) 0%, transparent 50%);
      pointer-events: none;
    }
    .pdf-cover-content { position: relative; z-index: 1; }
    .pdf-cover-badge {
      display: inline-block; background: rgba(59,130,246,0.15);
      border: 1px solid rgba(59,130,246,0.3); padding: 8px 24px;
      border-radius: 100px; font-size: 0.85rem; color: #3b82f6;
      margin-bottom: 32px; letter-spacing: 1px;
    }
    .pdf-cover h1 {
      font-family: 'Outfit', sans-serif; font-size: 3.2rem; font-weight: 900;
      line-height: 1.2; margin-bottom: 20px;
      background: linear-gradient(135deg, #fff 20%, #3b82f6 50%, #8b5cf6 80%);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
    }
    .pdf-cover-sub { font-size: 1.1rem; color: #94a3b8; max-width: 700px; margin: 0 auto 48px; }
    .pdf-cover-stats { display: flex; justify-content: center; gap: 56px; margin-bottom: 48px; }
    .pdf-cover-stat-num {
      font-family: 'Outfit', sans-serif; font-size: 2.4rem; font-weight: 800;
      background: linear-gradient(135deg, #3b82f6, #8b5cf6);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
    }
    .pdf-cover-stat-label { font-size: 0.85rem; color: #94a3b8; margin-top: 4px; }
    .pdf-cover-meta { margin-top: 32px; font-size: 0.9rem; color: #64748b; }
    .pdf-cover-meta strong { color: #94a3b8; }

    /* ━━ 섹션 공통 ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */
    .pdf-section { max-width: 1100px; margin: 0 auto; padding: 0 12px; }
    .pdf-sh { text-align: center; margin-bottom: 16px; padding-top: 4px; }
    .pdf-sh-num {
      font-family: 'Outfit', sans-serif; font-size: 0.7rem; font-weight: 700;
      letter-spacing: 3px; color: #3b82f6; margin-bottom: 4px;
    }
    .pdf-sh-title {
      font-family: 'Outfit', sans-serif; font-size: 1.5rem; font-weight: 800;
      color: #f8fafc; margin-bottom: 6px;
    }
    .pdf-sh-desc { color: #94a3b8; max-width: 600px; margin: 0 auto; font-size: 0.8rem; }

    /* ━━ 스탯 행 ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */
    .pdf-sr { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin: 12px 0; }
    .pdf-sb {
      background: #1a2236; border-radius: 12px; padding: 14px 10px;
      text-align: center; border: 1px solid rgba(255,255,255,0.04);
    }
    .pdf-sb-n { font-family: 'Outfit', sans-serif; font-size: 1.3rem; font-weight: 800; margin-bottom: 2px; }
    .pdf-sb-l { font-size: 0.68rem; color: #94a3b8; }

    /* ━━ 인사이트 박스 ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */
    .pdf-ins {
      background: linear-gradient(135deg, rgba(59,130,246,0.08), rgba(139,92,246,0.08));
      border: 1px solid rgba(59,130,246,0.2); border-radius: 12px;
      padding: 14px 18px; margin: 10px 0;
    }
    .pdf-ins h4 { font-size: 0.82rem; color: #3b82f6; margin-bottom: 6px; }
    .pdf-ins p { font-size: 0.75rem; color: #e2e8f0; line-height: 1.6; }

    /* ━━ SWOT 그리드 ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */
    .pdf-swot { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin: 12px 0; }
    .pdf-swot-c { padding: 12px 14px; border-radius: 10px; border: 1px solid rgba(255,255,255,0.06); }
    .pdf-swot-c h5 { font-size: 0.78rem; font-weight: 700; margin-bottom: 6px; }
    .pdf-swot-c ul { list-style: none; padding: 0; margin: 0; }
    .pdf-swot-c li { font-size: 0.7rem; color: #94a3b8; padding: 1px 0 1px 12px; position: relative; }
    .pdf-swot-c li::before { content: '\2022'; position: absolute; left: 0; color: #3b82f6; }

    /* ━━ 참조자료 ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */
    .pdf-src {
      margin-top: 12px; padding: 12px 16px; background: #1a2236;
      border-radius: 10px; border: 1px solid rgba(255,255,255,0.04);
    }
    .pdf-src h4 { font-size: 0.75rem; font-weight: 700; color: #f8fafc; margin-bottom: 6px; }
    .pdf-src ul { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 2px 16px; }
    .pdf-src li { font-size: 0.65rem; padding: 2px 0; color: #94a3b8; }
    .pdf-src a { color: #3b82f6; text-decoration: none; }

    /* ━━ 메가트렌드 카드 ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */
    .pdf-tg { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-bottom: 16px; }
    .pdf-tc { border-radius: 12px; padding: 14px 16px; }
    .pdf-tc--a { background: linear-gradient(135deg, rgba(239,68,68,0.08), rgba(245,158,11,0.08)); border: 1px solid rgba(245,158,11,0.15); }
    .pdf-tc--b { background: linear-gradient(135deg, rgba(59,130,246,0.08), rgba(139,92,246,0.08)); border: 1px solid rgba(59,130,246,0.15); }
    .pdf-tc--c { background: linear-gradient(135deg, rgba(16,185,129,0.08), rgba(6,182,212,0.08)); border: 1px solid rgba(16,185,129,0.15); }
    .pdf-tc h4 { font-size: 0.88rem; color: #f8fafc; margin-bottom: 4px; }
    .pdf-tc p { font-size: 0.72rem; color: #94a3b8; line-height: 1.55; }

    /* ━━ 비교 테이블 ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */
    .pdf-ct { width: 100%; border-collapse: separate; border-spacing: 0 5px; margin: 14px 0; }
    .pdf-ct th { text-align: left; padding: 8px 10px; font-size: 0.68rem; font-weight: 600; color: #94a3b8; text-transform: uppercase; letter-spacing: 1px; }
    .pdf-ct td { padding: 10px; background: #1a2236; font-size: 0.72rem; color: #e2e8f0; }
    .pdf-ct tr td:first-child { border-radius: 8px 0 0 8px; }
    .pdf-ct tr td:last-child { border-radius: 0 8px 8px 0; }

    /* ━━ 결론 ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */
    .pdf-end {
      background: linear-gradient(135deg, rgba(59,130,246,0.1), rgba(139,92,246,0.1));
      border-radius: 18px; padding: 40px 36px; text-align: center;
      border: 1px solid rgba(59,130,246,0.15); margin-top: 20px;
    }
    .pdf-end h2 { font-family: 'Outfit', sans-serif; font-size: 1.6rem; font-weight: 800; margin-bottom: 14px; color: #f8fafc; }
    .pdf-end p { color: #94a3b8; max-width: 650px; margin: 0 auto; font-size: 0.82rem; line-height: 1.65; }

    /* ━━ 플로우 ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */
    .pdf-fl { display: flex; align-items: center; gap: 5px; justify-content: center; margin: 12px 0; }
    .pdf-fl-s { background: #1a2236; border: 1px solid rgba(255,255,255,0.06); border-radius: 10px; padding: 8px 12px; text-align: center; min-width: 90px; }
    .pdf-fl-s-i { font-size: 1.1rem; margin-bottom: 2px; }
    .pdf-fl-s-t { font-size: 0.65rem; font-weight: 600; color: #e2e8f0; }
    .pdf-fl-a { font-size: 0.9rem; color: #3b82f6; }

    /* ━━ 인쇄 버튼 ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */
    .pdf-bar {
      position: fixed; top: 0; left: 0; right: 0; z-index: 100;
      background: rgba(10,14,26,0.95); backdrop-filter: blur(12px);
      border-bottom: 1px solid rgba(255,255,255,0.06);
      padding: 10px 24px; display: flex; align-items: center; justify-content: space-between;
    }
    .pdf-bar span { color: #94a3b8; font-size: 0.8rem; }
    .pdf-bar a { color: #94a3b8; text-decoration: none; font-size: 0.8rem; }
    .pdf-bar a:hover { color: #3b82f6; }
    .pdf-btn {
      background: linear-gradient(135deg, #3b82f6, #8b5cf6); color: #fff; border: none;
      padding: 8px 24px; border-radius: 100px; font-size: 0.85rem; font-weight: 600;
      cursor: pointer; font-family: 'Noto Sans KR', sans-serif;
    }
    .pdf-btn:hover { opacity: 0.9; }
  </style>
</head>
<body class="pdf-mode">

<!-- 인쇄 버튼 바 -->
<div class="pdf-bar no-print">
  <div style="display: flex; align-items: center; gap: 16px;">
    <a href="/deep-research">← Deep Research로 돌아가기</a>
    <span>|</span>
    <span>Ctrl+P (Cmd+P) → 가로 방향 → 배경 그래픽 체크</span>
  </div>
  <button class="pdf-btn" onclick="window.print()">PDF로 저장</button>
</div>

<!-- ═══ PAGE 1: 표지 ═══ -->
<div class="pdf-cover">
  <div class="pdf-cover-content">
    <div class="pdf-cover-badge">TEAM-J Deep Research</div>
    <h1>AI 사업 아이템<br>심층 리서치 보고서</h1>
    <p class="pdf-cover-sub">4개 핵심 사업 아이템에 대한 시장 데이터, 기술 동향, 정책 환경을 근거 자료와 함께 심층 분석</p>
    <div class="pdf-cover-stats">
      <div><div class="pdf-cover-stat-num">4</div><div class="pdf-cover-stat-label">핵심 아이템</div></div>
      <div><div class="pdf-cover-stat-num">20+</div><div class="pdf-cover-stat-label">참조 자료</div></div>
      <div><div class="pdf-cover-stat-num">10</div><div class="pdf-cover-stat-label">데이터 차트</div></div>
    </div>
    <div class="pdf-cover-meta"><strong>2026.03</strong> &nbsp;|&nbsp; TEAM-J : 이정로, 정영, 이진영</div>
  </div>
</div>

<!-- ═══ PAGE 2: 거시환경 - 전제 + 고령화 차트 ═══ -->
<div class="pdf-page">
  <div class="pdf-section">
    <div class="pdf-sh">
      <div class="pdf-sh-num">MACRO TRENDS</div>
      <div class="pdf-sh-title">거시 환경 분석</div>
      <p class="pdf-sh-desc">초고령사회 진입, 1인가구 급증, AI 대중화 — 4개 아이템 모두를 관통하는 메가트렌드</p>
    </div>
    <div class="pdf-tg">
      <div class="pdf-tc pdf-tc--a"><h4>👥 소비자 니즈</h4><p>미충족 니즈에서 출발한 아이템이 <strong style="color:#f59e0b;">전체의 64%</strong>. 페인포인트가 핵심 동인.</p></div>
      <div class="pdf-tc pdf-tc--b"><h4>🤖 기술변화</h4><p>AI/NLP, IoT, 컴퓨터비전 등 <strong style="color:#3b82f6;">기술 변곡점</strong> 기반 아이템이 <strong style="color:#3b82f6;">100%</strong>.</p></div>
      <div class="pdf-tc pdf-tc--c"><h4>📈 메가트렌드</h4><p>초고령사회, AI 대중화, 개인화 등 <strong style="color:#10b981;">거시 트렌드</strong> 연계 아이템 <strong style="color:#10b981;">82%</strong>.</p></div>
    </div>
    <AgingTrendChart client:load />
  </div>
</div>

<!-- ═══ PAGE 3: 1인가구 + AI시장 지표 ═══ -->
<div class="pdf-page">
  <div class="pdf-section">
    <SingleHouseholdChart client:load />
    <div class="pdf-sr" style="margin-top:16px;">
      <div class="pdf-sb"><div class="pdf-sb-n" style="color:#3b82f6;">6.3조원</div><div class="pdf-sb-l">한국 AI 시장 매출(2024)</div></div>
      <div class="pdf-sb"><div class="pdf-sb-n" style="color:#8b5cf6;">CAGR 32.7%</div><div class="pdf-sb-l">AI 기업 수 증가율</div></div>
      <div class="pdf-sb"><div class="pdf-sb-n" style="color:#06b6d4;">60%</div><div class="pdf-sb-l">AI 에이전트 도입 예정(2025)</div></div>
      <div class="pdf-sb"><div class="pdf-sb-n" style="color:#f59e0b;">$78.7B</div><div class="pdf-sb-l">글로벌 AI-in-IoT 시장</div></div>
    </div>
  </div>
</div>

<!-- ═══ PAGE 4: 아이템1 통계 + 간병보험 차트 ═══ -->
<div class="pdf-page">
  <div class="pdf-section">
    <div class="pdf-sh">
      <div class="pdf-sh-num">ITEM 01</div>
      <div class="pdf-sh-title">AI 인지저하 탐지 + 간병보험 연계</div>
      <p class="pdf-sh-desc">스마트폰 사용 패턴·음성 분석으로 초기 인지 저하를 탐지, 간병보험 리스크 관리 연계</p>
    </div>
    <div class="pdf-sr">
      <div class="pdf-sb"><div class="pdf-sb-n" style="color:#3b82f6;">{item1Stats.marketSize}</div><div class="pdf-sb-l">{item1Stats.marketSizeLabel}</div></div>
      <div class="pdf-sb"><div class="pdf-sb-n" style="color:#ef4444;">{item1Stats.growth}</div><div class="pdf-sb-l">{item1Stats.growthLabel}</div></div>
      <div class="pdf-sb"><div class="pdf-sb-n" style="color:#f59e0b;">{item1Stats.targetUsers}</div><div class="pdf-sb-l">{item1Stats.targetUsersLabel}</div></div>
      <div class="pdf-sb"><div class="pdf-sb-n" style="color:#06b6d4;">{item1Stats.nationalCost}</div><div class="pdf-sb-l">{item1Stats.nationalCostLabel}</div></div>
    </div>
    <CaregivingInsuranceChart client:load />
  </div>
</div>

<!-- ═══ PAGE 5: 아이템1 치매전망 + 기술동향 ═══ -->
<div class="pdf-page">
  <div class="pdf-section">
    <DementiaProjectionChart client:load />
    <div class="pdf-ins">
      <h4>핵심 기술 동향</h4>
      <p><strong>Samsung Research</strong>: 스마트폰/웨어러블 데이터 기반 디지털 바이오마커 기술. 병원 기반 치매 선별검사와 <strong>동등한 정확도</strong>. 2026년 중반 미국·한국 공개 베타 예정.</p>
    </div>
    <div class="pdf-ins">
      <h4>경쟁사 분석</h4>
      <p><strong>Linus Health</strong>(미국): Gartner 2025 등재, Aural Analytics(FDA 혁신기기) 인수. <strong>LANGaware</strong>(유럽): 음성 바이오마커 MCI 감지. AI 음성 MCI 탐지 <strong>AUC 0.945~0.988</strong>.</p>
    </div>
  </div>
</div>

<!-- ═══ PAGE 6: 아이템1 SWOT + 참조 ═══ -->
<div class="pdf-page">
  <div class="pdf-section">
    <div class="pdf-sh" style="margin-bottom:12px;">
      <div class="pdf-sh-num">ITEM 01</div>
      <div class="pdf-sh-title" style="font-size:1.3rem;">SWOT 분석 — AI 인지저하 탐지 + 간병보험</div>
    </div>
    <div class="pdf-swot">
